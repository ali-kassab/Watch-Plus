# ---- Server ----
NODE_ENV=development
PORT=4000
# Origin of the Next.js frontend (used for CORS and links in e-mails)
FRONTEND_URL=http://localhost:3000

# ---- Database ----
DATABASE_URL="postgresql://pulsewatch:pulsewatch@localhost:5432/pulsewatch?schema=public"

# ---- Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))") ----
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# ---- Encryption of notification channel secrets (32 bytes, base64) ----
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# ---- Monitoring engine ----
SCHEDULER_ENABLED=true
SCHEDULER_TICK_MS=2000
SCHEDULER_MAX_CONCURRENCY=20
CHECK_RETENTION_DAYS=90
# Never enable in production: allows monitors/webhooks to target private networks (SSRF)
ALLOW_PRIVATE_TARGETS=false

# ---- E-mail (SMTP). MAIL_TRANSPORT=log only writes e-mails to the server log ----
MAIL_TRANSPORT=log
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="PulseWatch <alerts@pulsewatch.local>"

# ---- Rate limiting ----
THROTTLE_LIMIT=300
